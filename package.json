{
  "name": "cosplay-chess",
  "version": "1.0.0",
  "description": "Cosplay Chess Battle Engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "Rubra Studios",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.rubrastudios.cosplaychess",
    "productName": "Cosplay Chess",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "img/favicon-Photoroom.png"
    },
    "files": [
      "**/*",
      "!dist/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rubertt12/COSPLAYCHESS.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Rubertt12/COSPLAYCHESS/issues"
  },
  "homepage": "https://github.com/Rubertt12/COSPLAYCHESS#readme"
