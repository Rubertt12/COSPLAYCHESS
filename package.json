{
  "name": "cosplay-chess",
  "version": "1.0.0",
  "description": "Cosplay Chess Battle Engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "Rubra Studios",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rubrastudios.cosplaychess",
    "productName": "Cosplay Chess",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "img/favicon-Photoroom.png"
    },
    "files": [
      "**/*",
      "!dist/*"
    ]
  }
}